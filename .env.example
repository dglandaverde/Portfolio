# ════════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copiar a `.env.local` y rellenar. `.env.local` está en .gitignore.
#
#  REGLA DE ORO
#  ────────────
#  Toda variable con prefijo NEXT_PUBLIC_ se INCRUSTA en el bundle
#  del navegador y es PÚBLICA. Cualquier otra sólo existe en el
#  servidor y nunca sale de él.
#  El esquema en `src/lib/env.ts` valida esto en tiempo de build:
#  si falta una variable o tiene formato inválido, el build FALLA.
# ════════════════════════════════════════════════════════════════

# ─── SERVIDOR · SECRETOS ────────────────────── (nunca en el cliente)

# Resend — API key del servicio de correo. https://resend.com/api-keys
# Se usa únicamente dentro de /api/contact, en el servidor.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente verificado en Resend. Debe ser un dominio verificado.
CONTACT_FROM_EMAIL="portfolio@tudominio.com"

# Buzón donde se reciben los mensajes del formulario de contacto.
CONTACT_TO_EMAIL="tu-correo@ejemplo.com"

# ─── SERVIDOR · OPCIONALES ───────────────────────────────────────

# Límite de envíos del formulario por IP dentro de la ventana.
RATE_LIMIT_MAX_REQUESTS="5"

# Ventana del rate limit, en segundos.
RATE_LIMIT_WINDOW_SECONDS="600"

# ─── PÚBLICAS ──────────────── (visibles en el navegador, sin secretos)

# URL canónica del sitio. Alimenta sitemap, robots, canonical y Open Graph.
#
# DEBE ser la dirección real donde está publicado el sitio. Si apunta a un
# dominio que no existe, los buscadores indexan enlaces rotos y las vistas
# previas al compartir en redes dejan de funcionar.
#
# Al contratar un dominio propio, basta con cambiar este valor aquí y en
# las variables de entorno de Vercel.
NEXT_PUBLIC_SITE_URL="https://portfolio-nu-eosin-11.vercel.app"
